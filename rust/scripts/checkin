#!/usr/bin/env bash
#
# checkin — quality-gated git commit for FASTER Rust
#
# Usage: rust/scripts/checkin [--skip-tests] <git-commit args...>
#   e.g.  rust/scripts/checkin -m "feat: add epoch framework"
#
# Runs fmt → clippy → doctests → tests, then stages & commits.
# Aborts on first failure. Use --skip-tests to run only fmt + clippy.

set -euo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
RESET='\033[0m'

# ── Resolve repo root ──────────────────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo -e "${RED}❌ Not inside a git repository.${RESET}" >&2
    exit 1
}

RUST_DIR="$REPO_ROOT/rust"
if [[ ! -f "$RUST_DIR/Cargo.toml" ]]; then
    echo -e "${RED}❌ Cannot find rust/Cargo.toml — is this the FASTER repo?${RESET}" >&2
    exit 1
fi

# ── Parse --skip-tests flag ────────────────────────────────────────────────
SKIP_TESTS=false
COMMIT_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--skip-tests" ]]; then
        SKIP_TESTS=true
    else
        COMMIT_ARGS+=("$arg")
    fi
done

if [[ ${#COMMIT_ARGS[@]} -eq 0 ]]; then
    echo -e "${RED}❌ No commit arguments provided. Usage: checkin -m \"message\"${RESET}" >&2
    exit 1
fi

# ── Helpers ─────────────────────────────────────────────────────────────────
GATE_FAILED=""

run_gate() {
    local name="$1"
    shift
    local start end elapsed

    echo -e "\n${BOLD}▶ ${name}${RESET}"
    echo "  $ $*"

    start=$(date +%s)
    if "$@"; then
        end=$(date +%s)
        elapsed=$((end - start))
        echo -e "${GREEN}  ✅ ${name} passed${RESET}  (${elapsed}s)"
    else
        end=$(date +%s)
        elapsed=$((end - start))
        echo -e "${RED}  ❌ ${name} FAILED${RESET}  (${elapsed}s)"
        GATE_FAILED="$name"
        return 1
    fi
}

# ── Auto-append Co-authored-by trailer if -m message provided ─────────────
TRAILER="Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>"
FINAL_COMMIT_ARGS=()
MESSAGE_AMENDED=false

i=0
while [[ $i -lt ${#COMMIT_ARGS[@]} ]]; do
    arg="${COMMIT_ARGS[$i]}"
    if [[ "$arg" == "-m" && $((i + 1)) -lt ${#COMMIT_ARGS[@]} ]]; then
        msg="${COMMIT_ARGS[$((i + 1))]}"
        if [[ "$msg" != *"$TRAILER"* ]]; then
            msg="$msg"$'\n\n'"$TRAILER"
        fi
        FINAL_COMMIT_ARGS+=("-m" "$msg")
        MESSAGE_AMENDED=true
        i=$((i + 2))  # skip the message value, we already consumed it
    else
        FINAL_COMMIT_ARGS+=("$arg")
        i=$((i + 1))
    fi
done

# If no -m flag was found, pass args as-is (user may use --message=... or editor)
if [[ "$MESSAGE_AMENDED" == false ]]; then
    FINAL_COMMIT_ARGS=("${COMMIT_ARGS[@]}")
fi

# ── Run gates ───────────────────────────────────────────────────────────────
cd "$RUST_DIR"

echo -e "${BOLD}═══ FASTER Rust Checkin ═══${RESET}"
if [[ "$SKIP_TESTS" == true ]]; then
    echo -e "${YELLOW}⚡ --skip-tests: running fmt + clippy only${RESET}"
fi

run_gate "cargo fmt (check)" \
    cargo fmt -p faster-core -- --check || {
    echo -e "\n${RED}💡 Fix: run 'cargo fmt -p faster-core' then retry.${RESET}" >&2
    exit 1
}

run_gate "cargo clippy" \
    cargo clippy -p faster-core --all-targets -- -D warnings || {
    echo -e "\n${RED}💡 Fix: address the clippy warnings above then retry.${RESET}" >&2
    exit 1
}

if [[ "$SKIP_TESTS" == false ]]; then
    run_gate "cargo test --doc" \
        cargo test --doc -p faster-core || {
        echo -e "\n${RED}💡 Fix: repair the failing doctests above then retry.${RESET}" >&2
        exit 1
    }

    if command -v cargo-nextest &>/dev/null || cargo nextest --version &>/dev/null 2>&1; then
        run_gate "cargo nextest run" \
            cargo nextest run -p faster-core || {
            echo -e "\n${RED}💡 Fix: repair the failing tests above then retry.${RESET}" >&2
            exit 1
        }
    else
        echo -e "${YELLOW}  ⚠ nextest not found — falling back to cargo test${RESET}"
        run_gate "cargo test" \
            cargo test -p faster-core || {
            echo -e "\n${RED}💡 Fix: repair the failing tests above then retry.${RESET}" >&2
            exit 1
        }
    fi
fi

# ── All gates passed — commit ───────────────────────────────────────────────
echo -e "\n${GREEN}${BOLD}✅ All quality gates passed!${RESET}"
echo -e "${BOLD}▶ Staging and committing...${RESET}"

cd "$REPO_ROOT"
git add -A
git commit "${FINAL_COMMIT_ARGS[@]}"

echo -e "\n${GREEN}${BOLD}✅ Commit successful.${RESET}"
