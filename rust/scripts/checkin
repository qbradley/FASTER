#!/usr/bin/env bash
#
# checkin — quality-gated git commit for FASTER Rust
#
# Usage: rust/scripts/checkin [--skip-tests] <git-commit args...>
#   e.g.  rust/scripts/checkin -m "feat: add epoch framework"
#
# Runs precheckin (fmt → clippy → doctests → tests), then stages & commits.
# Aborts on first failure. Use --skip-tests to run only fmt + clippy.

set -euo pipefail

# ── Resolve script directory and repo root ─────────────────────────────────
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo -e '\033[0;31m❌ Not inside a git repository.\033[0m' >&2
    exit 1
}

# ── Separate --skip-tests from git-commit args ─────────────────────────────
PRECHECKIN_ARGS=()
COMMIT_ARGS=()
for arg in "$@"; do
    if [[ "$arg" == "--skip-tests" ]]; then
        PRECHECKIN_ARGS+=("--skip-tests")
    else
        COMMIT_ARGS+=("$arg")
    fi
done

if [[ ${#COMMIT_ARGS[@]} -eq 0 ]]; then
    echo -e '\033[0;31m❌ No commit arguments provided. Usage: checkin -m "message"\033[0m' >&2
    exit 1
fi

# ── Run precheckin validation ──────────────────────────────────────────────
"$SCRIPT_DIR/precheckin" "${PRECHECKIN_ARGS[@]}" || exit $?

# ── Auto-append Co-authored-by trailer if -m message provided ─────────────
TRAILER="Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>"
FINAL_COMMIT_ARGS=()
MESSAGE_AMENDED=false

i=0
while [[ $i -lt ${#COMMIT_ARGS[@]} ]]; do
    arg="${COMMIT_ARGS[$i]}"
    if [[ "$arg" == "-m" && $((i + 1)) -lt ${#COMMIT_ARGS[@]} ]]; then
        msg="${COMMIT_ARGS[$((i + 1))]}"
        if [[ "$msg" != *"$TRAILER"* ]]; then
            msg="$msg"$'\n\n'"$TRAILER"
        fi
        FINAL_COMMIT_ARGS+=("-m" "$msg")
        MESSAGE_AMENDED=true
        i=$((i + 2))
    else
        FINAL_COMMIT_ARGS+=("$arg")
        i=$((i + 1))
    fi
done

if [[ "$MESSAGE_AMENDED" == false ]]; then
    FINAL_COMMIT_ARGS=("${COMMIT_ARGS[@]}")
fi

# ── Stage and commit ────────────────────────────────────────────────────────
BOLD='\033[1m'
GREEN='\033[0;32m'
RESET='\033[0m'

echo -e "\n${BOLD}▶ Staging and committing...${RESET}"
cd "$REPO_ROOT"
git add -A
git commit "${FINAL_COMMIT_ARGS[@]}"

echo -e "\n${GREEN}${BOLD}✅ Commit successful.${RESET}"
