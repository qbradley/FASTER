#!/usr/bin/env bash
#
# quick — fast iteration check for faster-core
#
# Usage: rust/scripts/quick
#
# Runs fmt + faster-core tests (foreground) + clippy (background, parallel).
# Clippy starts with a short delay so nextest grabs the build lock first;
# clippy then builds in parallel once nextest releases the lock to run tests.
# Clippy results are shown after tests, only if tests passed.
# Exit code 0 = all gates passed, non-zero = failure.

set -uo pipefail

# ── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
DIM='\033[2m'
RESET='\033[0m'

# ── Resolve repo root ──────────────────────────────────────────────────────
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo -e "${RED}❌ Not inside a git repository.${RESET}" >&2
    exit 1
}

RUST_DIR="$REPO_ROOT/rust"
if [[ ! -f "$RUST_DIR/Cargo.toml" ]]; then
    echo -e "${RED}❌ Cannot find rust/Cargo.toml — is this the FASTER repo?${RESET}" >&2
    exit 1
fi

cd "$RUST_DIR"

echo -e "${BOLD}═══ FASTER Quick Check (faster-core) ═══${RESET}"

# ── Step 1: cargo fmt ───────────────────────────────────────────────────────
echo -e "\n${BOLD}▶ cargo fmt${RESET}"
if ! cargo fmt --all 2>&1; then
    echo -e "${RED}  ❌ cargo fmt failed${RESET}"
    exit 1
fi
echo -e "${GREEN}  ✅ formatted${RESET}"

# ── Step 2: Launch clippy in background with delay ──────────────────────────
CLIPPY_LOG=$(mktemp /tmp/quick-clippy-XXXXXX.log)
(
    # Short delay so nextest grabs the build lock first.
    # nextest builds, then releases the lock to execute tests.
    # clippy then acquires the lock and runs in parallel with test execution.
    sleep 2
    cargo clippy --workspace --all-targets -- -D warnings >"$CLIPPY_LOG" 2>&1
    echo $? >"${CLIPPY_LOG}.exit"
) &
CLIPPY_PID=$!

# ── Step 3: Run faster-core tests in foreground ────────────────────────────
echo -e "\n${BOLD}▶ cargo nextest run -p faster-core${RESET}"
TEST_START=$(date +%s)
cargo nextest run -p faster-core
TEST_EXIT=$?
TEST_END=$(date +%s)
TEST_ELAPSED=$((TEST_END - TEST_START))

if [[ $TEST_EXIT -ne 0 ]]; then
    echo -e "${RED}  ❌ tests FAILED${RESET}  (${TEST_ELAPSED}s)"
    # Kill clippy — no point waiting
    kill $CLIPPY_PID 2>/dev/null
    wait $CLIPPY_PID 2>/dev/null
    rm -f "$CLIPPY_LOG" "${CLIPPY_LOG}.exit"
    exit 1
fi
echo -e "${GREEN}  ✅ tests passed${RESET}  (${TEST_ELAPSED}s)"

# ── Step 4: Wait for clippy and report ──────────────────────────────────────
echo -e "\n${DIM}  ⏳ waiting for clippy...${RESET}"
wait $CLIPPY_PID 2>/dev/null

CLIPPY_EXIT=0
if [[ -f "${CLIPPY_LOG}.exit" ]]; then
    CLIPPY_EXIT=$(cat "${CLIPPY_LOG}.exit")
fi

if [[ "$CLIPPY_EXIT" -ne 0 ]]; then
    echo -e "\n${BOLD}▶ clippy output${RESET}"
    cat "$CLIPPY_LOG"
    echo -e "${RED}  ❌ clippy FAILED${RESET}"
    rm -f "$CLIPPY_LOG" "${CLIPPY_LOG}.exit"
    exit 1
fi

echo -e "${GREEN}  ✅ clippy clean${RESET}"

# ── Cleanup ─────────────────────────────────────────────────────────────────
rm -f "$CLIPPY_LOG" "${CLIPPY_LOG}.exit"
echo -e "\n${GREEN}${BOLD}✅ Quick check passed!${RESET}"
