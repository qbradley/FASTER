#!/usr/bin/env bash
#
# Minimize the fuzz corpus for FASTER Rust targets.
#
# Uses `cargo fuzz cmin` (corpus minimization) to reduce corpus size
# while preserving coverage. Smaller corpora mean faster startup on
# future fuzz runs and smaller Git footprint.
#
# Usage:
#   ./scripts/fuzz-minimize                     # Minimize all targets
#   ./scripts/fuzz-minimize --target hash       # Minimize one target
#
# Requirements:
#   - Rust nightly toolchain
#   - cargo-fuzz: cargo install cargo-fuzz

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RUST_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
FUZZ_DIR="$RUST_DIR/fuzz"
CORPUS_DIR="$FUZZ_DIR/corpus"

ALL_TARGETS=(
    fuzz_record_parsing
    fuzz_record_layout
    fuzz_compaction_record_size
    fuzz_hash
    fuzz_store_ops
)

# ── Parse arguments ───────────────────────────────────────────────────
SELECTED_TARGET=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --target)
            if [[ -z "${2:-}" ]]; then
                echo "ERROR: --target requires an argument" >&2
                exit 1
            fi
            SELECTED_TARGET="$2"
            shift 2
            ;;
        --help|-h)
            head -15 "$0" | grep '^#' | sed 's/^# \?//'
            exit 0
            ;;
        *)
            echo "ERROR: Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

# ── Resolve target list ──────────────────────────────────────────────
if [[ -n "$SELECTED_TARGET" ]]; then
    CANONICAL="$SELECTED_TARGET"
    if [[ ! "$CANONICAL" == fuzz_* ]]; then
        CANONICAL="fuzz_${CANONICAL}"
    fi
    FOUND=false
    for t in "${ALL_TARGETS[@]}"; do
        if [[ "$t" == "$CANONICAL" ]]; then
            FOUND=true
            break
        fi
    done
    if [[ "$FOUND" == false ]]; then
        echo "ERROR: Unknown target '$SELECTED_TARGET'" >&2
        echo "Available targets:" >&2
        for t in "${ALL_TARGETS[@]}"; do
            echo "  - ${t#fuzz_}" >&2
        done
        exit 1
    fi
    TARGETS=("$CANONICAL")
else
    TARGETS=("${ALL_TARGETS[@]}")
fi

# ── Preflight ─────────────────────────────────────────────────────────
if ! command -v cargo-fuzz &>/dev/null; then
    echo "ERROR: cargo-fuzz not found. Install with: cargo install cargo-fuzz" >&2
    exit 1
fi

# ── Minimize ──────────────────────────────────────────────────────────
cd "$FUZZ_DIR"

for target in "${TARGETS[@]}"; do
    TARGET_CORPUS="$CORPUS_DIR/$target"
    if [[ ! -d "$TARGET_CORPUS" ]]; then
        echo "⚠ Skipping $target — no corpus at $TARGET_CORPUS"
        continue
    fi

    BEFORE=$(find "$TARGET_CORPUS" -type f | wc -l)
    echo "────────────────────────────────────────────────────────────────"
    echo "  Minimizing: $target (${BEFORE} files)"
    echo "────────────────────────────────────────────────────────────────"

    if cargo fuzz cmin "$target" "$TARGET_CORPUS" 2>&1; then
        AFTER=$(find "$TARGET_CORPUS" -type f | wc -l)
        echo "  ✓ $target: ${BEFORE} → ${AFTER} corpus files"
    else
        echo "  ✗ $target: minimization failed"
    fi
    echo ""
done

echo "Done. Commit the minimized corpus with: git add rust/fuzz/corpus/ && git commit"
